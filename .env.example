# OpenAlex (opcional — sin key funciona, con key mejor rate limit)
OPENALEX_API_KEY=
OPENALEX_MAILTO=tu@email.com

# Crossref polite pool
CROSSREF_MAILTO=tu@email.com

# Semantic Scholar (opcional — sin key ~1 req/s, con key ~100 req/s)
# Obtén una gratis en: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Ruta al archivo bibliografia.bib (default: ./bibliografia.bib)
BIBLIOGRAPHY_PATH=./bibliografia.bib

# EZProxy (opcional — acceso a papers de pago via proxy institucional)
EZPROXY_HOST=
# EZPROXY_PUBLISHER_MAP como JSON: {"ieeexplore.ieee.org": "ieeexplore.tuproxy.edu", ...}
EZPROXY_PUBLISHER_MAP=

# Sci-Hub (opcional — último recurso para papers sin acceso abierto)
# SCIHUB_ENABLED=1
# SCIHUB_MIRRORS=sci-hub.ru,sci-hub.st,sci-hub.ee,sci-hub.se

# Cache directory (default: /tmp/search_cache)
# SEARCH_CACHE_DIR=/tmp/search_cache

# Unpaywall email (requerido para usar la API)
UNPAYWALL_EMAIL=tu@email.com
